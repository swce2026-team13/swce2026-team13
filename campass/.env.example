# Node.js 24, persistent local disk. Use /data/campass.sqlite on a mounted volume.
DATABASE_PATH=./data/campass.sqlite
# Single administrator. Use a password of at least 12 characters. Never use NEXT_PUBLIC_.
ADMIN_ID=
ADMIN_PASSWORD=
# Public origin of this application in production, e.g. https://your-app.up.railway.app
APP_ORIGIN=
# Leave blank until your trained model/API is ready. HTTPS required except localhost.
VISION_API_URL=
VISION_API_KEY=
INTENT_API_URL=
INTENT_API_KEY=
# Optional Gemini fallback for questions the keyword rules cannot resolve. Server only; never use NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=
