# Node.js 24, 로컬 디스크에 저장. 볼륨을 붙이면 /data/campass.sqlite 사용
DATABASE_PATH=./data/campass.sqlite
# 관리자 1명. 비밀번호는 12자 이상. NEXT_PUBLIC_ 접두사 쓰지 않기
ADMIN_ID=
ADMIN_PASSWORD=
# 배포 시 앱 주소 (예: https://your-app.up.railway.app)
APP_ORIGIN=
# 모델/API가 준비될 때까지 비워 두기. localhost 외에는 HTTPS 필요
VISION_API_URL=
VISION_API_KEY=
INTENT_API_URL=
INTENT_API_KEY=
# 규칙으로 못 찾은 질문을 Gemini로 보완 (선택). 서버 전용, NEXT_PUBLIC_ 쓰지 않기
GEMINI_API_KEY=
GEMINI_MODEL=
