# Node.js 24. 서버 전용: Supabase Connect > Transaction pooler (port 6543).
# 실제 연결 문자열과 새 DB 비밀번호는 .env.local에만 입력하세요.
DATABASE_URL=
# Supabase Database Settings > SSL Configuration에서 내려받은 CA 인증서의 PEM 내용.
# 원격 DB에서 인증서 체인을 검증할 때 사용합니다. 줄바꿈은 실제 줄바꿈 또는 \\n으로 입력할 수 있습니다.
DATABASE_CA_CERT=
# 마이그레이션/SQLite 이전 전용: Supabase Direct connection 또는 Session pooler.
MIGRATION_DATABASE_URL=
# 테스트/시연은 별도 로컬 PostgreSQL 데이터베이스에서만 실행됩니다.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/campass_test
DEMO_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/campass_demo
# 기존 SQLite 데이터 이전을 선택할 때만 사용합니다. 원본은 읽기 전용입니다.
SQLITE_SOURCE_PATH=
# 관리자 1명. 비밀번호는 12자 이상. NEXT_PUBLIC_ 접두사 쓰지 않기
ADMIN_ID=
ADMIN_PASSWORD=
# Production 공개 주소 (예: https://campass.example.com). 가변 Preview 주소에서는 비워 둡니다.
APP_ORIGIN=
# 모델/API가 준비될 때까지 비워 두기. localhost 외에는 HTTPS 필요
VISION_API_URL=
VISION_API_KEY=
INTENT_API_URL=
INTENT_API_KEY=
# 규칙으로 못 찾은 질문을 Gemini로 보완 (선택). 서버 전용, NEXT_PUBLIC_ 쓰지 않기
GEMINI_API_KEY=
GEMINI_MODEL=
