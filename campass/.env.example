# Node.js 24, persistent local disk. Use /data/campass.sqlite on a mounted volume.
DATABASE_PATH=./data/campass.sqlite
# Generate a random value of at least 24 characters. Never use NEXT_PUBLIC_ for keys.
ADMIN_TOKEN=
# Public origin of this application in production, e.g. https://your-app.up.railway.app
APP_ORIGIN=
# Leave blank until your trained model/API is ready. HTTPS required except localhost.
VISION_API_URL=
VISION_API_KEY=
INTENT_API_URL=
INTENT_API_KEY=
